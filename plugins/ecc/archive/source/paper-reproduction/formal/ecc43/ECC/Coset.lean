import ECC.Parity

namespace ECC

/-- Every translate by a word of the mother has weight at least `d`. -/
def Far (K : Submodule F2 (Word 40)) (d : ℕ) (a : Word 40) : Prop :=
  ∀ k ∈ K, d ≤ weight (a + k)

/-- The universal conclusion needed from the complete no-edge computation.
Unlike a list-only assertion this quantifies over every even 40-bit word. -/
def PairIncompatible (K : Submodule F2 (Word 40)) : Prop :=
  ∀ a b : Word 40, Even (weight a) → Even (weight b) →
    Far K 16 a → Far K 16 b → ¬ Far K 16 (a + b)

def appendTail (a : Word 40) (t : Word 4) : Word 44 :=
  fun i => Fin.addCases (m := 40) (n := 4) (motive := fun _ => F2) a t i

@[simp] theorem appendTail_add (a b : Word 40) (s t : Word 4) :
    appendTail (a + b) (s + t) = appendTail a s + appendTail b t := by
  funext i
  refine Fin.addCases (m := 40) (n := 4) ?_ ?_ i
  · intro j
    simp [appendTail]
  · intro j
    simp [appendTail]

@[simp] theorem weight_appendTail (a : Word 40) (t : Word 4) :
    weight (appendTail a t) = weight a + weight t := by
  simp only [weight, Finset.card_eq_sum_ones, Finset.sum_filter]
  rw [Fin.sum_univ_add (a := 40) (b := 4)]
  simp [appendTail]

def tail1 : Word 4 := ![1, 0, 0, 1]
def tail2 : Word 4 := ![0, 1, 0, 1]
def tail3 : Word 4 := ![0, 0, 1, 1]

/-- Exact seven nonzero tail weights of the claimed standard form. -/
theorem standard_tail_weights :
    weight tail1 = 2 ∧ weight tail2 = 2 ∧ weight tail3 = 2 ∧
    weight (tail1 + tail2) = 2 ∧ weight (tail1 + tail3) = 2 ∧
    weight (tail2 + tail3) = 2 ∧ weight (tail1 + tail2 + tail3) = 4 := by
  decide

@[simp] theorem tail1_weight : weight tail1 = 2 := standard_tail_weights.1
@[simp] theorem tail2_weight : weight tail2 = 2 := standard_tail_weights.2.1
@[simp] theorem tail3_weight : weight tail3 = 2 := standard_tail_weights.2.2.1
@[simp] theorem tail12_weight : weight (tail1 + tail2) = 2 :=
  standard_tail_weights.2.2.2.1

/-- This is an actual submodule of 44-coordinate words, generated by the
embedded mother and the three displayed extension rows. -/
def StandardExtension (K : Submodule F2 (Word 40)) (a b c : Word 40) :
    Submodule F2 (Word 44) :=
  Submodule.span F2
    (Set.range (fun k : K => appendTail k.val 0) ∪
      {appendTail a tail1, appendTail b tail2, appendTail c tail3})

theorem kernel_mem_standardExtension (K : Submodule F2 (Word 40))
    (a b c k : Word 40) (hk : k ∈ K) :
    appendTail k 0 ∈ StandardExtension K a b c := by
  apply Submodule.subset_span
  exact Or.inl ⟨⟨k, hk⟩, rfl⟩

theorem row1_mem_standardExtension (K : Submodule F2 (Word 40)) (a b c : Word 40) :
    appendTail a tail1 ∈ StandardExtension K a b c := by
  apply Submodule.subset_span
  exact Or.inr (by simp)

theorem row2_mem_standardExtension (K : Submodule F2 (Word 40)) (a b c : Word 40) :
    appendTail b tail2 ∈ StandardExtension K a b c := by
  apply Submodule.subset_span
  exact Or.inr (by simp)

theorem row3_mem_standardExtension (K : Submodule F2 (Word 40)) (a b c : Word 40) :
    appendTail c tail3 ∈ StandardExtension K a b c := by
  apply Submodule.subset_span
  exact Or.inr (by simp)

/-- The distance 18 condition on an actual extension forces distance 16
from the mother for every row whose four-coordinate tail has weight 2. -/
theorem far_of_minWeight (K : Submodule F2 (Word 40))
    (C : Submodule F2 (Word 44))
    (hK : ∀ k ∈ K, appendTail k 0 ∈ C) (hC : MinWeight C 18)
    (a : Word 40) (t : Word 4) (hrow : appendTail a t ∈ C)
    (ht : weight t = 2) : Far K 16 a := by
  intro k hk
  have hmem : appendTail (a + k) t ∈ C := by
    simpa only [← appendTail_add, add_zero] using C.add_mem hrow (hK k hk)
  have hne : appendTail (a + k) t ≠ 0 := by
    intro hz
    have hw := congrArg weight hz
    simp only [weight_appendTail, ht, weight_zero] at hw
    omega
  have hbound := hC _ hmem hne
  rw [weight_appendTail, ht] at hbound
  omega

/-- Load-bearing fixed-mother rejection: a universal no-edge theorem excludes
the actual standard 44-coordinate extension, independent of the third row. -/
theorem no_standardExtension_of_pairIncompatible
    (K : Submodule F2 (Word 40)) (hPairs : PairIncompatible K)
    (a b c : Word 40) (hEven : EvenCode (StandardExtension K a b c)) :
    ¬ MinWeight (StandardExtension K a b c) 18 := by
  intro hMin
  let C := StandardExtension K a b c
  have hK : ∀ k ∈ K, appendTail k 0 ∈ C :=
    fun k hk => kernel_mem_standardExtension K a b c k hk
  have ha := row1_mem_standardExtension K a b c
  have hb := row2_mem_standardExtension K a b c
  have hab : appendTail (a + b) (tail1 + tail2) ∈ C := by
    rw [appendTail_add]
    exact C.add_mem ha hb
  have hea : Even (weight a) := by
    simpa [weight_appendTail, Nat.even_add] using hEven _ ha
  have heb : Even (weight b) := by
    simpa [weight_appendTail, Nat.even_add] using hEven _ hb
  have hfa := far_of_minWeight K C hK hMin a tail1 ha tail1_weight
  have hfb := far_of_minWeight K C hK hMin b tail2 hb tail2_weight
  have hfab := far_of_minWeight K C hK hMin (a + b) (tail1 + tail2) hab tail12_weight
  exact hPairs a b hea heb hfa hfb hfab

theorem word_add_self {n : ℕ} (a : Word n) : a + a = 0 := by
  funext i
  exact CharTwo.add_self_eq_zero (a i)

theorem not_far_zero (K : Submodule F2 (Word 40)) : ¬ Far K 16 0 := by
  intro h
  have hz := h 0 K.zero_mem
  simp at hz

/-- Coset distance is invariant under any change of representative by K. -/
theorem far_iff_of_sub_mem (K : Submodule F2 (Word 40)) (d : ℕ)
    (a b : Word 40) (hba : b - a ∈ K) : Far K d b ↔ Far K d a := by
  constructor
  · intro hb k hk
    have hmem : -(b - a) + k ∈ K := K.add_mem (K.neg_mem hba) hk
    have h := hb (-(b - a) + k) hmem
    have heq : b + (-(b - a) + k) = a + k := by abel
    rwa [heq] at h
  · intro ha k hk
    have hmem : (b - a) + k ∈ K := K.add_mem hba hk
    have h := ha ((b - a) + k) hmem
    have heq : a + ((b - a) + k) = b + k := by abel
    rwa [heq] at h

/-- Explicit saved-pair witnesses prove rejection of the saved candidate set.
The witness `k` is an actual mother word, not a Boolean verifier result. -/
def SavedPairWitnesses (K : Submodule F2 (Word 40)) (F : Finset (Word 40)) : Prop :=
  ∀ a ∈ F, ∀ b ∈ F, a ≠ b → ∃ k ∈ K, weight (a + b + k) < 16

/-- An upper-triangular indexed witness array suffices for all distinct pairs.
This accounts for the `i < j` convention used by the native pair scanner. -/
theorem savedPairWitnesses_of_indexed {m : ℕ}
    (K : Submodule F2 (Word 40)) (vertices : Fin m → Word 40)
    (hPairs : ∀ i j, i < j → ∃ k ∈ K, weight (vertices i + vertices j + k) < 16) :
    SavedPairWitnesses K (Finset.univ.image vertices) := by
  intro a ha b hb hab
  obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp ha
  obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hb
  have hij : i ≠ j := fun h => hab (congrArg vertices h)
  rcases lt_or_gt_of_ne hij with hlt | hgt
  · exact hPairs i j hlt
  · obtain ⟨k, hk, hw⟩ := hPairs j i hgt
    exact ⟨k, hk, by simpa only [add_comm (vertices i) (vertices j)] using hw⟩

/-- Exhaustive rejection witnesses give candidate completeness. Merely checking
the accepted entries does not supply the hypothesis of this theorem. -/
theorem complete_of_rejection_witnesses
    (K : Submodule F2 (Word 40)) (F : Finset (Word 40))
    (Normalized : Word 40 → Prop)
    (hCoverage : ∀ a, Normalized a → Even (weight a) →
      a ∈ F ∨ ∃ k ∈ K, weight (a + k) < 16) :
    ∀ a, Normalized a → Even (weight a) → Far K 16 a → a ∈ F := by
  intro a hn he hf
  rcases hCoverage a hn he with ha | ⟨k, hk, hw⟩
  · exact ha
  · have hbound := hf k hk
    omega

theorem savedPairWitnesses_reject (K : Submodule F2 (Word 40))
    (F : Finset (Word 40)) (hF : SavedPairWitnesses K F)
    (a b : Word 40) (ha : a ∈ F) (hb : b ∈ F) : ¬ Far K 16 (a + b) := by
  by_cases hab : a = b
  · subst b
    simpa only [word_add_self] using not_far_zero K
  · obtain ⟨k, hk, hw⟩ := hF a ha b hb hab
    intro hfar
    have hbound := hfar k hk
    omega

/-- The precise bridge from exhaustive normalized candidate coverage and
saved pair witnesses to universal incompatibility. All coverage, normalization,
parity, and actual certificate obligations remain explicit hypotheses. -/
theorem pairIncompatible_of_complete_saved_witnesses
    (K : Submodule F2 (Word 40)) (F : Finset (Word 40))
    (Normalized : Word 40 → Prop) (normalize : Word 40 → Word 40)
    (hShift : ∀ a, normalize a - a ∈ K)
    (hNormal : ∀ a, Normalized (normalize a))
    (hParity : ∀ a, Even (weight a) → Even (weight (normalize a)))
    (hComplete : ∀ a, Normalized a → Even (weight a) → Far K 16 a → a ∈ F)
    (hWitnesses : SavedPairWitnesses K F) : PairIncompatible K := by
  intro a b hea heb hfa hfb hfab
  have hna : Far K 16 (normalize a) :=
    (far_iff_of_sub_mem K 16 a (normalize a) (hShift a)).mpr hfa
  have hnb : Far K 16 (normalize b) :=
    (far_iff_of_sub_mem K 16 b (normalize b) (hShift b)).mpr hfb
  have hma := hComplete _ (hNormal a) (hParity a hea) hna
  have hmb := hComplete _ (hNormal b) (hParity b heb) hnb
  have hsum : normalize a + normalize b - (a + b) ∈ K := by
    have h := K.add_mem (hShift a) (hShift b)
    convert h using 1; abel
  have hfarSum : Far K 16 (normalize a + normalize b) :=
    (far_iff_of_sub_mem K 16 (a + b) (normalize a + normalize b) hsum).mpr hfab
  exact savedPairWitnesses_reject K F hWitnesses _ _ hma hmb hfarSum

/-- For an even mother, preservation of parity follows from the proved
normalization shift, so it need not be assumed independently. -/
theorem pairIncompatible_of_even_complete_saved_witnesses
    (K : Submodule F2 (Word 40)) (hEvenK : EvenCode K)
    (F : Finset (Word 40))
    (Normalized : Word 40 → Prop) (normalize : Word 40 → Word 40)
    (hShift : ∀ a, normalize a - a ∈ K)
    (hNormal : ∀ a, Normalized (normalize a))
    (hComplete : ∀ a, Normalized a → Even (weight a) → Far K 16 a → a ∈ F)
    (hWitnesses : SavedPairWitnesses K F) : PairIncompatible K := by
  apply pairIncompatible_of_complete_saved_witnesses K F Normalized normalize
    hShift hNormal ?_ hComplete hWitnesses
  intro a ha
  exact even_weight_of_even_sub ha (hEvenK _ (hShift a))

/-- Subtracting a linear projection onto the mother is a genuine coset
normalization. A systematic pivot-clearing implementation must realize such
a projection (and connect its free-bit encoding to the candidate list). -/
def normalizeByProjection (K : Submodule F2 (Word 40))
    (projection : Word 40 →ₗ[F2] K) (a : Word 40) : Word 40 :=
  a - (projection a : Word 40)

theorem normalizeByProjection_shift (K : Submodule F2 (Word 40))
    (projection : Word 40 →ₗ[F2] K) (a : Word 40) :
    normalizeByProjection K projection a - a ∈ K := by
  have h := K.neg_mem (projection a).property
  dsimp [normalizeByProjection]
  convert h using 1; abel

theorem normalizeByProjection_normal (K : Submodule F2 (Word 40))
    (projection : Word 40 →ₗ[F2] K)
    (hRetract : ∀ k : K, projection k.val = k) (a : Word 40) :
    projection (normalizeByProjection K projection a) = 0 := by
  simp only [normalizeByProjection, map_sub, hRetract, sub_self]

theorem pairIncompatible_of_projection_certificates
    (K : Submodule F2 (Word 40)) (hEvenK : EvenCode K)
    (F : Finset (Word 40)) (projection : Word 40 →ₗ[F2] K)
    (hRetract : ∀ k : K, projection k.val = k)
    (hComplete : ∀ a, projection a = 0 → Even (weight a) → Far K 16 a → a ∈ F)
    (hWitnesses : SavedPairWitnesses K F) : PairIncompatible K := by
  exact pairIncompatible_of_even_complete_saved_witnesses K hEvenK F
    (fun a => projection a = 0) (normalizeByProjection K projection)
    (normalizeByProjection_shift K projection)
    (normalizeByProjection_normal K projection hRetract) hComplete hWitnesses

/-- The connected fixed-mother theorem, with its actual remaining input
obligations exposed: a correct projection, complete vertices, valid witnesses. -/
theorem no_standardExtension_of_projection_certificates
    (K : Submodule F2 (Word 40)) (hEvenK : EvenCode K)
    (F : Finset (Word 40)) (projection : Word 40 →ₗ[F2] K)
    (hRetract : ∀ k : K, projection k.val = k)
    (hComplete : ∀ a, projection a = 0 → Even (weight a) → Far K 16 a → a ∈ F)
    (hWitnesses : SavedPairWitnesses K F)
    (a b c : Word 40) (hEvenC : EvenCode (StandardExtension K a b c)) :
    ¬ MinWeight (StandardExtension K a b c) 18 := by
  exact no_standardExtension_of_pairIncompatible K
    (pairIncompatible_of_projection_certificates K hEvenK F projection
      hRetract hComplete hWitnesses) a b c hEvenC

end ECC
