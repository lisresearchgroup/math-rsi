def AlonJaegerTarsi.AffineBasisTools.AtDim.{u_5} : (K : Type u_5) → [Field K] → ℕ → Prop :=
fun K [Field K] d => ∀ (M : Matrix (Fin d) (Fin d) K), M.det ≠ 0 → AffineAJT M
def AlonJaegerTarsi.AffineReduction.AffineAJT.{u_1} : {K : Type u_1} →
  [Field K] → {n : ℕ} → Matrix (Fin n) (Fin n) K → Prop :=
fun {K} [Field K] {n} A => ∀ (b : Fin n → K), ∃ x, NowhereZero x ∧ NowhereZero (A *ᵥ x + b)
def SolSameDimensionAudit.RawHomogeneous : {p n : ℕ} → Matrix (Fin n) (Fin n) (ZMod p) → Prop :=
fun {p n} A => ∃ x, (∀ (j : Fin n), x j ≠ 0) ∧ ∀ (i : Fin n), ∑ j, A i j * x j ≠ 0
def SolSameDimensionAudit.RawAffine : {p n : ℕ} → Matrix (Fin n) (Fin n) (ZMod p) → Prop :=
fun {p n} A => ∀ (a b : Fin n → ZMod p), ∃ x, (∀ (j : Fin n), x j ≠ a j) ∧ ∀ (i : Fin n), ∑ j, A i j * x j ≠ b i
