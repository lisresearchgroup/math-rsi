def AlonJaegerTarsi.NowhereZero.{u_1, u_2} : {α : Type u_1} → {F : Type u_2} → [Zero F] → (α → F) → Prop :=
fun {α} {F} [Zero F] x => ∀ (i : α), x i ≠ 0
def AlonJaegerTarsi.HasAJTVector.{u_1} : {n : ℕ} → {F : Type u_1} → [CommRing F] → Matrix (Fin n) (Fin n) F → Prop :=
fun {n} {F} [CommRing F] A => ∃ x, AlonJaegerTarsi.NowhereZero x ∧ AlonJaegerTarsi.NowhereZero (A *ᵥ x)
def AlonJaegerTarsi.AJTConjecture : Prop :=
∀ (p : ℕ) [inst : Fact (Nat.Prime p)],
