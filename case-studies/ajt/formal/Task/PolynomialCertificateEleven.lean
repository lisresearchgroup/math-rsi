theorem spectrum_full_positive_of_v23_eq_zero {W V : WeightTable 11} {mass : ℤ}
    (h : SpectrumConstraints 11 W V mass) (hm : 0 < mass) (hz : V 2 3 = 0) :
    0 < W (Fin.last 11) (Fin.last 11) := by
  apply full_positive_of_multipliers_with_zeros h hm multipliers11 kernel11
  · have hk := checkPairs (fun i j : WeightIndex 11 => kernel11 i j = krawTable 11 i j)
      (fun _ _ => inferInstance) (by decide)
    exact funext (fun i => funext (hk i))
  · exact checkPairs _ (fun _ _ => inferInstance) (by decide)
  · have hv := checkPairs (fun i j : WeightIndex 11 =>
        dualException i j ∨ (i = 2 ∧ j = 3) ∨ (i = 3 ∧ j = 2) ∨ 0 ≤ multipliers11.vcoef i j)
        (fun _ _ => inferInstance) (by decide)
    intro i j
    rcases hv i j with he | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | hn
    · exact Or.inl he
    · exact Or.inr (Or.inl hz)
    · exact Or.inr (Or.inl ((h.vsymm 3 2).trans hz))
    · exact Or.inr (Or.inr hn)
  · decide

