import Task.Basic

/-! Invertible diagonal perturbations with a designated active kernel coordinate. -/

noncomputable section

namespace AlonJaegerTarsi.PermanentApproach

open Matrix
open scoped BigOperators

variable {ι F : Type*} [Fintype ι] [DecidableEq ι] [Field F] [Fintype F]

private def partialRows (A B : Matrix ι ι F) (s : Finset ι) (d : ι → F) : Matrix ι ι F :=
  fun j => if j ∈ s then A j - d j • (1 : Matrix ι ι F) j else B j

omit [Fintype ι] [Fintype F] in
private theorem partialRows_insert (A B : Matrix ι ι F) (s : Finset ι)
    (d : ι → F) (j : ι) (t : F) :
    partialRows A B (insert j s) (Function.update d j t) =
      (partialRows A B s d).updateRow j (A j - t • (1 : Matrix ι ι F) j) := by
  ext i k
  by_cases hi : i = j
  · subst i
    simp [partialRows]
  · simp [partialRows, hi]

omit [Fintype F] in
private theorem det_update_affine (M : Matrix ι ι F) (i : ι) (a b : ι → F) (t : F) :
    (M.updateRow i (a - t • b)).det =
      (M.updateRow i a).det - t * (M.updateRow i b).det := by
  rw [sub_eq_add_neg, ← neg_smul, det_updateRow_add, det_updateRow_smul]
  simp [sub_eq_add_neg]

private theorem exists_avoid_three (hF : 3 < Fintype.card F) (a b : F) :
    ∃ t : F, t ≠ 0 ∧ t ≠ a ∧ t ≠ b := by
  classical
  let bad : Finset F := {0, a, b}
  have hcard : bad.card < Fintype.card F := by
    apply lt_of_le_of_lt _ hF
    calc
      bad.card ≤ ({a, b} : Finset F).card + 1 := Finset.card_insert_le _ _
      _ ≤ (({b} : Finset F).card + 1) + 1 := by
        exact Nat.add_le_add_right (Finset.card_insert_le _ _) 1
      _ = 3 := by simp
  obtain ⟨t, _, ht⟩ := Finset.exists_mem_notMem_of_card_lt_card
    (s := bad) (t := Finset.univ) hcard
  exact ⟨t, by simpa [bad, not_or] using ht⟩

/-- Outside a prescribed set the two matrices keep their initial rows from A and I.
On the chosen rows a single nonzero diagonal perturbation keeps both matrices invertible. -/
private theorem choose_partial_rows (A : Matrix ι ι F) (hA : A.det ≠ 0)
    (hF : 3 < Fintype.card F) (s : Finset ι) :
    ∃ d : ι → F, (∀ i ∈ s, d i ≠ 0) ∧
      (partialRows A A s d).det ≠ 0 ∧ (partialRows A 1 s d).det ≠ 0 := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    have hbase (B : Matrix ι ι F) : partialRows A B ∅ 0 = B := by ext; simp [partialRows]
    exact ⟨0, by simp, by rwa [hbase], by simp [hbase]⟩
  | @insert j s hjs ih =>
    obtain ⟨d, hd, hM, hN⟩ := ih
    let M := partialRows A A s d
    let N := partialRows A 1 s d
    let e := (1 : Matrix ι ι F) j
    have hMj : M j = A j := by simp [M, partialRows, hjs]
    have hNj : N j = e := by simp [N, partialRows, hjs, e]
    let c := (M.updateRow j e).det
    let b := (N.updateRow j (A j)).det
    obtain ⟨t, ht, ha, hb⟩ := exists_avoid_three hF (M.det / c) (b / N.det)
    refine ⟨Function.update d j t, ?_, ?_, ?_⟩
    · intro i hi
      rcases Finset.mem_insert.mp hi with h | h
      · subst i
        simpa using ht
      · have hij : i ≠ j := fun e => hjs (e ▸ h)
        simpa [Function.update_of_ne hij] using hd i h
    · rw [partialRows_insert]
      change (M.updateRow j (A j - t • e)).det ≠ 0
      rw [det_update_affine, ← hMj, updateRow_eq_self]
      change M.det - t * c ≠ 0
      intro h
      by_cases hc : c = 0
      · exact hM (by simpa [hc] using h)
      · exact ha ((eq_div_iff hc).mpr (sub_eq_zero.mp h).symm)
    · rw [partialRows_insert]
      change (N.updateRow j (A j - t • e)).det ≠ 0
      rw [det_update_affine, ← hNj, updateRow_eq_self]
      exact fun h => hb ((eq_div_iff hN).mpr (sub_eq_zero.mp h).symm)

/-- For any designated coordinate there is an invertible diagonal perturbation of corank one
whose kernel is generated by a vector nonzero in that coordinate. -/
theorem exists_diagonal_kernel_at (A : Matrix ι ι F) (hA : A.det ≠ 0)
    (hF : 3 < Fintype.card F) (i : ι) :
    ∃ (d x : ι → F), NowhereZero d ∧ x i ≠ 0 ∧ (∀ j, (A *ᵥ x) j = d j * x j) ∧
      ∀ y, (∀ j, (A *ᵥ y) j = d j * y j) → ∃ t : F, y = t • x := by
  classical
  let s := Finset.univ.erase i
  obtain ⟨d, hd, hM, hN⟩ := choose_partial_rows A hA hF s
  let M := partialRows A A s d
  let N := partialRows A 1 s d
  let u : ι → F := Pi.single i 1
  let x := M⁻¹ *ᵥ u
  have hMx : M *ᵥ x = u := by
    dsimp only [x]
    rw [mulVec_mulVec, M.mul_nonsing_inv (isUnit_iff_ne_zero.mpr hM), one_mulVec]
  have hrow (j : ι) (hj : j ≠ i) : M j = A j - d j • (1 : Matrix ι ι F) j := by
    simp [M, partialRows, s, hj]
  have hrowi : M i = A i := by simp [M, partialRows, s]
  have hrowN (j : ι) (hj : j ≠ i) : N j = M j := by simp [M, N, partialRows, s, hj]
  have hrowNi : N i = (1 : Matrix ι ι F) i := by simp [N, partialRows, s]
  have he (z : ι → F) (j : ι) : ((1 : Matrix ι ι F) j) ⬝ᵥ z = z j :=
    congrFun (one_mulVec z) j
  have hMi : (A *ᵥ x) i = 1 := by
    have h := congrFun hMx i
    change M i ⬝ᵥ x = u i at h
    simpa [hrowi, u, Matrix.mulVec] using h
  have hx : x i ≠ 0 := by
    intro hxi
    have hNx : N *ᵥ x = 0 := by
      ext j
      change N j ⬝ᵥ x = 0
      by_cases hj : j = i
      · subst j
        rw [hrowNi, he, hxi]
      · rw [hrowN j hj]
        simpa [u, Pi.single_apply, hj, Matrix.mulVec] using congrFun hMx j
    have hinj := mulVec_injective_of_isUnit ((isUnit_iff_isUnit_det N).mpr (isUnit_iff_ne_zero.mpr hN))
    have hx0 : x = 0 := hinj (hNx.trans (N.mulVec_zero).symm)
    simp [hx0] at hMi
  let diag := Function.update d i ((x i)⁻¹)
  have hd' : NowhereZero diag := by
    intro j
    by_cases hj : j = i
    · subst j
      simpa [diag] using hx
    · simpa [diag, hj] using hd j (by simp [s, hj])
  refine ⟨diag, x, hd', hx, ?_, ?_⟩
  · intro j
    by_cases hj : j = i
    · subst j
      simp [diag, hMi, hx]
    · have hc := congrFun hMx j
      change M j ⬝ᵥ x = u j at hc
      rw [hrow j hj, sub_dotProduct, smul_dotProduct, he] at hc
      apply sub_eq_zero.mp
      simpa [u, Pi.single_apply, diag, hj, Matrix.mulVec] using hc
  · intro y hy
    let t := (A *ᵥ y) i
    refine ⟨t, ?_⟩
    apply mulVec_injective_of_isUnit ((isUnit_iff_isUnit_det M).mpr (isUnit_iff_ne_zero.mpr hM))
    rw [mulVec_smul, hMx]
    ext j
    change M j ⬝ᵥ y = (t • u) j
    by_cases hj : j = i
    · subst j
      simp [hrowi, t, u, Matrix.mulVec]
    · rw [hrow j hj, sub_dotProduct, smul_dotProduct, he]
      simpa [u, Pi.single_apply, Matrix.mulVec, diag, hj] using
        sub_eq_zero.mpr (hy j)

omit [Fintype F] in
/-- If a nowhere-zero left kernel vector expresses a dependence among all the rows, changing
one row can only shrink the right kernel. Such a change cannot activate a missing coordinate. -/
theorem kernel_after_one_row (M : Matrix ι ι F) (v : ι → F) (hv : NowhereZero v)
    (hleft : v ᵥ* M = 0) (j : ι) (r x : ι → F) (hk : M.updateRow j r *ᵥ x = 0) :
    M *ᵥ x = 0 := by
  classical
  have hother (i : ι) (hi : i ≠ j) : (M *ᵥ x) i = 0 := by
    simpa [Matrix.mulVec, hi] using congrFun hk i
  have he : v ⬝ᵥ (M *ᵥ x) = 0 := by rw [dotProduct_mulVec, hleft, zero_dotProduct]
  rw [dotProduct, Finset.sum_eq_single j (fun i _ hi => by rw [hother i hi, mul_zero])
    (by simp)] at he
  ext i
  by_cases hi : i = j
  · exact hi ▸ (mul_eq_zero.mp he).resolve_left (hv j)
  · exact hother i hi

section SimpleRootSpan

/-- Keep many determinants nonzero during the same row-by-row diagonal choice.
On every processed row, a starting row must be either the original row or
the unit row giving the coefficient of its diagonal entry. -/
private theorem choose_partial_family {J : Type*} [Fintype J] (A : Matrix ι ι F)
    (B : J → Matrix ι ι F) (hB : ∀ k, (B k).det ≠ 0)
    (hsize : Fintype.card J+1 < Fintype.card F) (s : Finset ι)
    (hrow : ∀ j ∈ s, ∀ k, B k j = A j ∨ B k j = (1 : Matrix ι ι F) j) :
    ∃ d : ι → F, (∀ j ∈ s, d j ≠ 0) ∧ ∀ k, (partialRows A (B k) s d).det ≠ 0 := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨0,by simp,fun k => ?_⟩
    have he : partialRows A (B k) ∅ 0 = B k := by ext; simp [partialRows]
    rw [he]
    exact hB k
  | @insert j s hjs ih =>
    obtain ⟨d,hd,hm⟩ := ih (fun i hi k => hrow i (Finset.mem_insert_of_mem hi) k)
    let M (k : J) := partialRows A (B k) s d
    let e := (1 : Matrix ι ι F) j
    let a (k : J) := ((M k).updateRow j (A j)).det
    let b (k : J) := ((M k).updateRow j e).det
    have hab (k : J) : a k ≠ 0 ∨ b k ≠ 0 := by
      have hj : M k j = B k j := by simp [M,partialRows,hjs]
      rcases hrow j (Finset.mem_insert_self j s) k with h | h
      · left
        simpa [a,← hj.trans h] using hm k
      · right
        simpa [b,e,← hj.trans h] using hm k
    let bad : Finset F := insert 0 (Finset.univ.image (fun k => a k / b k))
    have hcard : bad.card < Fintype.card F := by
      apply lt_of_le_of_lt _ hsize
      calc
        bad.card ≤ (Finset.univ.image (fun k => a k / b k)).card+1 := Finset.card_insert_le _ _
        _ ≤ (Finset.univ : Finset J).card+1 := Nat.add_le_add_right Finset.card_image_le 1
        _ = Fintype.card J+1 := by simp
    obtain ⟨t,_,ht⟩ := Finset.exists_mem_notMem_of_card_lt_card (t:=Finset.univ) hcard
    have ht0 : t ≠ 0 := fun he => ht (he ▸ Finset.mem_insert_self _ _)
    refine ⟨Function.update d j t,?_,fun k => ?_⟩
    · intro i hi
      rcases Finset.mem_insert.mp hi with he | h
      · subst i
        simpa using ht0
      · have hne : i ≠ j := fun he => hjs (he ▸ h)
        simpa [Function.update_of_ne hne] using hd i h
    · rw [partialRows_insert,det_update_affine]
      change a k - t*b k ≠ 0
      intro hz
      by_cases hb : b k = 0
      · exact (hab k).resolve_right (not_not_intro hb) (by simpa [hb] using hz)
      · have he : t = a k / b k := (eq_div_iff hb).mpr (sub_eq_zero.mp hz).symm
        exact ht (Finset.mem_insert_of_mem (he ▸ Finset.mem_image_of_mem _ (Finset.mem_univ k)))

/-- Every matrix can be made nonsingular by adding a nowhere-zero diagonal
over a field with at least three elements. -/
theorem exists_invertible_diagonal_sum (A : Matrix ι ι F) (hF : 2 < Fintype.card F) :
    ∃ d : ι → F, NowhereZero d ∧ (diagonal d + A).det ≠ 0 := by
  classical
  obtain ⟨d,hd,hm⟩ := choose_partial_family A
    (fun _ : Unit => (1 : Matrix ι ι F)) (fun _ => by simp) (by simpa using hF)
    Finset.univ (fun _ _ _ => Or.inr rfl)
  refine ⟨-d,fun i => neg_ne_zero.mpr (hd i (Finset.mem_univ _)),?_⟩
  have he : diagonal (-d) + A = partialRows A 1 Finset.univ d := by
    ext i j
    by_cases h : i = j
    · subst j
      simp [partialRows,sub_eq_add_neg,add_comm]
    · simp [partialRows,diagonal_apply,Matrix.one_apply,h]
  rw [he]
  exact hm ()

/-- In addition to one selected coordinate, the generator of a simple
allowed diagonal root can escape any specified hyperplane whose normal
uses that coordinate. -/
theorem exists_diagonal_kernel_outside (A : Matrix ι ι F) (hA : A.det ≠ 0)
    (hF : 4 < Fintype.card F) (l : ι → F) (i : ι) (hl : l i ≠ 0) :
    ∃ d x : ι → F, NowhereZero d ∧ x i ≠ 0 ∧ l ⬝ᵥ x ≠ 0 ∧
      (∀ j, (A *ᵥ x) j = d j*x j) ∧
      ∀ y, (∀ j, (A *ᵥ y) j = d j*y j) → ∃ t : F, y = t • x := by
  classical
  let I : Matrix ι ι F := 1
  let L := I.updateRow i l
  let B : Fin 3 → Matrix ι ι F := ![A,I,L]
  have hinjL : Function.Injective L.mulVec := by
    intro x y h
    have he (j : ι) (hj : j ≠ i) : x j = y j := by
      have q := congrFun h j
      change L j ⬝ᵥ x = L j ⬝ᵥ y at q
      have hrow : L j = I j := by simp [L,hj]
      rw [hrow] at q
      change ((1 : Matrix ι ι F) *ᵥ x) j = ((1 : Matrix ι ι F) *ᵥ y) j at q
      simpa using q
    have hi := congrFun h i
    change L i ⬝ᵥ x = L i ⬝ᵥ y at hi
    have hri : L i = l := by simp [L]
    rw [hri] at hi
    have hz : l ⬝ᵥ (x-y) = 0 := by rw [dotProduct_sub,hi,sub_self]
    rw [dotProduct,Finset.sum_eq_single i (fun j _ hj => by simp [he j hj]) (by simp)] at hz
    ext j
    by_cases hj : j=i
    · subst j
      exact sub_eq_zero.mp ((mul_eq_zero.mp hz).resolve_left hl)
    · exact he j hj
  have hL : L.det ≠ 0 := ((isUnit_iff_isUnit_det L).mp
    (mulVec_injective_iff_isUnit.mp hinjL)).ne_zero
  have hB (k) : (B k).det ≠ 0 := by fin_cases k <;> simp_all [B,I,L] 
  let s := Finset.univ.erase i
  have hrows (j) (hj : j ∈ s) (k : Fin 3) : B k j = A j ∨ B k j = I j := by
    have hji := (Finset.mem_erase.mp hj).1
    fin_cases k <;> simp [B,I,L,hji]
  obtain ⟨d,hd,hm⟩ := choose_partial_family A B hB (by simpa using hF) s hrows
  let M := partialRows A A s d
  let u : ι → F := Pi.single i 1
  let x := M⁻¹ *ᵥ u
  have hM : M.det ≠ 0 := hm 0
  have hMx : M *ᵥ x = u := by
    dsimp only [x]
    rw [mulVec_mulVec,M.mul_nonsing_inv (isUnit_iff_ne_zero.mpr hM),one_mulVec]
  have hrow (j : ι) (hj : j ≠ i) : M j = A j - d j • I j := by
    simp [M, partialRows, s, hj, I]
  have hrowi : M i = A i := by simp [M,partialRows,s]
  have hunit (z : ι → F) (j : ι) : I j ⬝ᵥ z = z j := congrFun (one_mulVec z) j
  have hAi : (A *ᵥ x) i = 1 := by
    have h := congrFun hMx i
    change M i ⬝ᵥ x = u i at h
    simpa [u,hrowi,Matrix.mulVec] using h
  have htest (k : Fin 3) : B k i ⬝ᵥ x ≠ 0 := by
    intro hz
    let N := partialRows A (B k) s d
    have hNx : N *ᵥ x = 0 := by
      ext j
      change N j ⬝ᵥ x = 0
      by_cases hj : j=i
      · subst j
        simpa [N,partialRows,s] using hz
      · have hr : N j = M j := by simp [N,M,partialRows,s,hj]
        rw [hr]
        simpa [u,Pi.single_apply,hj,Matrix.mulVec] using congrFun hMx j
    have hinj := mulVec_injective_of_isUnit ((isUnit_iff_isUnit_det N).mpr
      (isUnit_iff_ne_zero.mpr (hm k)))
    have hx0 : x = 0 := hinj (hNx.trans N.mulVec_zero.symm)
    simp [hx0] at hAi
  have hxi : x i ≠ 0 := hunit x i ▸ htest 1
  have hxl : l ⬝ᵥ x ≠ 0 := by simpa [B,L] using htest 2
  let D := Function.update d i ((x i)⁻¹)
  refine ⟨D,x,?_,hxi,hxl,?_,?_⟩
  · intro j
    by_cases hj : j=i
    · subst j
      simpa [D] using hxi
    · simpa [D,hj] using hd j (by simp [s,hj])
  · intro j
    by_cases hj : j=i
    · subst j
      simp [D,hAi,hxi]
    · have h := congrFun hMx j
      change M j ⬝ᵥ x = u j at h
      rw [hrow j hj,sub_dotProduct,smul_dotProduct,hunit] at h
      apply sub_eq_zero.mp
      simpa [u,Pi.single_apply,D,hj,Matrix.mulVec] using h
  · intro y hy
    let t := (A *ᵥ y) i
    refine ⟨t,?_⟩
    apply mulVec_injective_of_isUnit ((isUnit_iff_isUnit_det M).mpr (isUnit_iff_ne_zero.mpr hM))
    rw [mulVec_smul,hMx]
    ext j
    change M j ⬝ᵥ y = (t • u) j
    by_cases hj : j=i
    · subst j
      simp [hrowi,t,u,Matrix.mulVec]
    · rw [hrow j hj,sub_dotProduct,smul_dotProduct,hunit]
      simpa [u,Pi.single_apply,Matrix.mulVec,D,hj] using sub_eq_zero.mpr (hy j)


/-- Vectors generating simple kernels of some invertible diagonal perturbation. -/
def simpleRootVectors (A : Matrix ι ι F) : Set (ι → F) := {x |
  x ≠ 0 ∧ ∃ d : ι → F, NowhereZero d ∧ (∀ j, (A *ᵥ x) j = d j*x j) ∧
    ∀ y, (∀ j, (A *ᵥ y) j = d j*y j) → ∃ t : F, y = t • x}

/-- The simple allowed-root vectors span the whole space as soon as the field
contains at least five elements. Some coordinates of these vectors can vanish. -/
theorem simple_root_vectors_span (A : Matrix ι ι F) (hA : A.det ≠ 0)
    (hF : 4 < Fintype.card F) : Submodule.span F (simpleRootVectors A) = ⊤ := by
  classical
  apply Submodule.dualAnnihilator_eq_bot_iff.mp
  apply bot_unique
  intro f hf
  change f = 0
  by_contra hne
  let l : ι → F := fun i => f (Pi.single i 1)
  have hdual (x : ι → F) : f x = l ⬝ᵥ x := by
    have hx : x = ∑ j, x j • (Pi.single j 1 : ι → F) := by
      ext k
      simp [Finset.sum_apply, Pi.single_apply]
    calc
      f x = f (∑ j, x j • Pi.single j 1) := congrArg _ hx
      _ = l ⬝ᵥ x := by simp [l,dotProduct,mul_comm]
  obtain ⟨i,hi⟩ : ∃ i, l i ≠ 0 := by
    by_contra! hz
    apply hne
    ext x
    simp [hdual,dotProduct,hz]
  obtain ⟨d,x,hd,hxi,hxl,hDx,hs⟩ := exists_diagonal_kernel_outside A hA hF l i hi
  have hn : x ≠ 0 := fun he => hxi (congrFun he i)
  have hm : x ∈ Submodule.span F (simpleRootVectors A) :=
    Submodule.subset_span ⟨hn,d,hd,hDx,hs⟩
  exact hxl ((hdual x).symm.trans ((Submodule.mem_dualAnnihilator _).mp hf x hm))

end SimpleRootSpan

end AlonJaegerTarsi.PermanentApproach
