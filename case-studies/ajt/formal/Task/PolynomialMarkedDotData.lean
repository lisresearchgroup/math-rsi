theorem tag_rep_action (t : Tuple) (h : ∑ i, t i = 0) : scalarToRep t ≠ 0 ∧
    ∀ i, t i = scalarToRep t * pRep (pTag t) (sitePerm (permToRep t) i) := (allDotStats t).1 h

theorem vTag_perm (t : Tuple) (g : Fin 12) :
    vTag (fun i => t (sitePerm g i)) = vTag t := (allDotStats t).2.1 g

theorem orbitRank_lt (t : Tuple) : orbitRank t < orbitSize (vTag t) := (allDotStats t).2.2.1

theorem member_rank (t : Tuple) : member (vTag t) (orbitRank t) = t := by
  unfold member
  rw [(allDotStats t).2.2.2, decode_encode]

private def memberStats (p : OM) (j : Fin (orbitSize p)) : Prop :=
  vTag (member p j.val) = p ∧ orbitRank (member p j.val) = j.val

private def memberStatsDec (p : OM) (j : Fin (orbitSize p)) : Decidable (memberStats p j) := by
  unfold memberStats
  infer_instance

private theorem allForFin {n : ℕ} (P : Fin n → Prop) (d : ∀ i, Decidable (P i))
    (h : @decide _ (@Nat.decidableForallFin n P d) = true) : ∀ i, P i :=
  @of_decide_eq_true _ (@Nat.decidableForallFin n P d) h
