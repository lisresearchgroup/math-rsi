private def perms : Fin 12 → Fin 5 → Fin 5 :=
  ![![0, 1, 2, 3, 4], ![0, 1, 2, 4, 3], ![0, 2, 1, 3, 4], ![0, 2, 1, 4, 3], ![1, 0, 2, 3, 4], ![1, 0, 2, 4, 3], ![1, 2, 0, 3, 4], ![1, 2, 0, 4, 3], ![2, 0, 1, 3, 4], ![2, 0, 1, 4, 3], ![2, 1, 0, 3, 4], ![2, 1, 0, 4, 3]]
private def inverses : Fin 12 → Fin 5 → Fin 5 :=
  ![![0, 1, 2, 3, 4], ![0, 1, 2, 4, 3], ![0, 2, 1, 3, 4], ![0, 2, 1, 4, 3], ![1, 0, 2, 3, 4], ![1, 0, 2, 4, 3], ![2, 0, 1, 3, 4], ![2, 0, 1, 4, 3], ![1, 2, 0, 3, 4], ![1, 2, 0, 4, 3], ![2, 1, 0, 3, 4], ![2, 1, 0, 4, 3]]

private theorem perm_inverse : ∀ g i, inverses g (perms g i) = i ∧ perms g (inverses g i) = i := by decide

def sitePerm (g : Fin 12) : Equiv.Perm (Fin 5) where
  toFun := perms g
  invFun := inverses g
  left_inv := fun i => (perm_inverse g i).1
  right_inv := fun i => (perm_inverse g i).2

