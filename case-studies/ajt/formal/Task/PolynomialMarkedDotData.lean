def orbitSize : OM → ℕ :=
  ![5, 40, 20, 40, 20, 60, 120, 120, 120, 120, 60, 120, 120, 120, 60, 120, 120, 60, 120, 60, 120, 240, 120, 240, 240, 60, 240, 120, 120]

private def actionCode (t : Tuple) : ℕ :=
  let z := encode t
  (pActionChunks (z/125) >>> (6*(z%125))) % 64

def scalarToRep (t : Tuple) : ZMod 5 := (1+actionCode t / 12 : ℕ)

def permToRep (t : Tuple) : Fin 12 := ⟨actionCode t % 12, Nat.mod_lt _ (by decide)⟩

def orbitRank (t : Tuple) : ℕ :=
  let z := encode t
  (vRankChunks (z/125) >>> (8*(z%125))) % 256

def memberCode (p : OM) (j : ℕ) : ℕ := (memberBits p.val >>> (12*j)) % 4096

def member (p : OM) (j : ℕ) : Tuple := decode (memberCode p j)

private def dotStats (t : Tuple) : Prop :=
  ((∑ i, t i) = 0 → scalarToRep t ≠ 0 ∧
    ∀ i, t i = scalarToRep t * pRep (pTag t) (sitePerm (permToRep t) i)) ∧
  (∀ g : Fin 12, vTag (fun i => t (sitePerm g i)) = vTag t) ∧
  orbitRank t < orbitSize (vTag t) ∧ memberCode (vTag t) (orbitRank t) = encode t

private def dotStatsDec (t : Tuple) : Decidable (dotStats t) := by
  unfold dotStats
  infer_instance
