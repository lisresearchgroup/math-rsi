private theorem positive6 {W V : WeightTable 6} {mass : ℤ}
    (h : SpectrumConstraints 6 W V mass) (hm : 0 < mass) :
    0 < W (Fin.last 6) (Fin.last 6) := by
  apply full_positive_of_multipliers h hm multipliers6 kernel6
  · have hk := checkPairs (fun i j : WeightIndex 6 => kernel6 i j = krawTable 6 i j)
      (fun _ _ => inferInstance) (by decide)
    exact funext (fun i => funext (hk i))
  · exact checkPairs _ (fun _ _ => inferInstance) (by decide)
  · exact checkPairs _ (fun _ _ => inferInstance) (by decide)
  · decide

