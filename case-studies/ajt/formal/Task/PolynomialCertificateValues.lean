/-- The exact split-enumerator inequalities force positive full weight for six through ten
coordinates in each half. -/
theorem spectrum_full_positive {n : ℕ} (hlo : 6 ≤ n) (hhi : n ≤ 10)
    {W V : WeightTable n} {mass : ℤ} (h : SpectrumConstraints n W V mass) (hm : 0 < mass) :
    0 < W (Fin.last n) (Fin.last n) := by
  interval_cases n
  · exact positive6 h hm
  · exact positive7 h hm
  · exact positive8 h hm
  · exact positive9 h hm
  · exact positive10 h hm

end AlonJaegerTarsi.WeightTransform
