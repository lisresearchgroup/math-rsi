set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

private def decidePairs {n : ℕ} (P : Fin n → Fin n → Prop)
    (d : ∀ i j, Decidable (P i j)) : Decidable (∀ i j, P i j) :=
  @Nat.decidableForallFin n _ (fun i => @Nat.decidableForallFin n _ (d i))

private theorem checkPairs {n : ℕ} (P : Fin n → Fin n → Prop)
    (d : ∀ i j, Decidable (P i j)) (h : @decide _ (decidePairs P d) = true) : ∀ i j, P i j :=
  @of_decide_eq_true _ (decidePairs P d) h

