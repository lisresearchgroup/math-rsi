import Task.PolynomialCertificate

/-! Local orbit data for a fixed five-coordinate dual word over the prime field of order five. -/

open scoped BigOperators
open Finset Matrix

namespace AlonJaegerTarsi.MarkedEleven

set_option maxHeartbeats 5000000

abbrev OM := Fin 29
abbrev X := Fin 9
abbrev Y := Fin 10
abbrev Tuple := Fin 5 → ZMod 5
abbrev Table := OM → X → Y → ℤ

def encode (t : Tuple) : ℕ :=
  ((((t 0).val * 5 + (t 1).val) * 5 + (t 2).val) * 5 + (t 3).val) * 5 + (t 4).val

