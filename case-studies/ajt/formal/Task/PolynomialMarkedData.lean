def K (p o : OM) : ℤ := (((kernelChunk p.val >>> (11*o.val)) % 2048 : ℕ) : ℤ) - 1024

def leftWt (t : Tuple) : Fin 4 :=
  ⟨(univ.filter (fun i : Fin 3 => t (Fin.castLE (by decide) i) ≠ 0)).card,
    by have := Finset.card_filter_le (univ : Finset (Fin 3))
        (fun i : Fin 3 => t (Fin.castLE (by decide) i) ≠ 0)
       simpa using Nat.lt_succ_of_le this⟩

def rightWt (t : Tuple) : Fin 3 :=
  ⟨(univ.filter (fun i : Fin 2 => t (Fin.natAdd 3 i) ≠ 0)).card,
    by have := Finset.card_filter_le (univ : Finset (Fin 2))
        (fun i : Fin 2 => t (Fin.natAdd 3 i) ≠ 0)
       simpa using Nat.lt_succ_of_le this⟩

def pwL (o : OM) : Fin 4 := leftWt (pRep o)

def pwR (o : OM) : Fin 3 := rightWt (pRep o)

def shifted (t : Tuple) (a : ZMod 5) : Tuple := fun i => t i + a

def shiftL (o : OM) (a : ZMod 5) : Fin 4 := leftWt (shifted (vRep o) a)

def shiftR (o : OM) (a : ZMod 5) : Fin 3 := rightWt (shifted (vRep o) a)

def vwL (o : OM) (u : Fin 4) : ℤ := (univ.filter (fun a : ZMod 5 => shiftL o a = u)).card

def vwR (o : OM) (u : Fin 3) : ℤ := (univ.filter (fun a : ZMod 5 => shiftR o a = u)).card

def primalForbidden (i j : ℕ) : Prop :=
  (i = 0 ∧ j ≠ 0) ∨ (j = 0 ∧ i ≠ 0) ∨ (i = 11 ∧ j = 11) ∨ (i = 3 ∧ j = 3) ∨
    (0 < min i j ∧ (i+j < 5 ∨ (i+j = 5 ∧ 1 < min i j)))

def dualForbidden (i j : ℕ) : Prop :=
  (i = 0 ∧ j ≠ 0) ∨ (j = 0 ∧ i ≠ 0) ∨
    (0 < min i j ∧ ((min i j = 1 ∧ max i j ≤ 3) ∨ (i = 2 ∧ j = 2)))

instance (i j : ℕ) : Decidable (primalForbidden i j) := by
  unfold primalForbidden
  infer_instance

instance (i j : ℕ) : Decidable (dualForbidden i j) := by
  unfold dualForbidden
  infer_instance

def wForbidden (o : OM) (b : X) (d : Y) : Prop := primalForbidden ((pwL o).val+b) ((pwR o).val+d)

def vForbidden (o : OM) (b : X) (d : Y) : Prop :=
  ∃ a : ZMod 5, dualForbidden ((shiftL o a).val+b) ((shiftR o a).val+d)

instance (o : OM) (b : X) (d : Y) : Decidable (wForbidden o b d) := by
  unfold wForbidden
  infer_instance

instance (o : OM) (b : X) (d : Y) : Decidable (vForbidden o b d) := by
  unfold vForbidden
  infer_instance

/-- Counts of a graph code and its dual after grouping the marked coordinates and the two
remaining Hamming weights. -/
structure MarkedConstraints (W V : Table) : Prop where
  wnonneg : ∀ o b d, 0 ≤ W o b d
  vnonneg : ∀ o b d, 0 ≤ V o b d
  wzero : W 0 0 0 = 1
  vzero : V 0 0 0 = 5
  wforbid : ∀ o b d, wForbidden o b d → W o b d = 0
  vforbid : ∀ o b d, vForbidden o b d → V o b d = 0
  wleft : ∀ (u : Fin 4) (b : X), (∑ o, ∑ d, if pwL o = u then W o b d else 0) =
    WeightTransform.sphere 3 u * WeightTransform.sphere 8 b
  wright : ∀ (u : Fin 3) (d : Y), (∑ o, ∑ b, if pwR o = u then W o b d else 0) =
    WeightTransform.sphere 2 u * WeightTransform.sphere 9 d
  vleft : ∀ (u : Fin 4) (b : X), (∑ o, ∑ d, vwL o u * V o b d) =
    5 * (WeightTransform.sphere 3 u * WeightTransform.sphere 8 b)
  vright : ∀ (u : Fin 3) (d : Y), (∑ o, ∑ b, vwR o u * V o b d) =
    5 * (WeightTransform.sphere 2 u * WeightTransform.sphere 9 d)
  transform : ∀ p k l, (5:ℤ)^11 * V p k l =
    ∑ o, ∑ b, ∑ d, W o b d * K p o * WeightTransform.kraw 5 8 k b * WeightTransform.kraw 5 9 l d

end AlonJaegerTarsi.MarkedEleven
