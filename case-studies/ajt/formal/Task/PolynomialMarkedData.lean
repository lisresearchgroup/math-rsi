private def tagFrom (c : ℕ → ℕ) (t : Tuple) : OM :=
  let i := encode t
  ⟨((c (i/125) >>> (5*(i%125))) % 32) % 29, Nat.mod_lt _ (by decide)⟩

def pTag (t : Tuple) : OM := tagFrom pChunk t

def vTag (t : Tuple) : OM := tagFrom vChunk t

