theorem marked_infeasible {W V : Table} : ¬ MarkedConstraints W V := by
  intro h
  apply impossible_of_score h score K8 K9 _ _ gValues tValues
  · exact funext (fun o => funext (fun b => funext (gChecked o b)))
  · exact funext (fun o => funext (fun b => funext (tChecked o b)))
  · exact wChecked
  · exact vChecked
  · decide
  · exact funext (fun k => funext ((checkPairs (fun k b : X => K8 k b = kx k b)
        (fun _ _ => inferInstance) (by decide)) k))
  · exact funext (fun l => funext ((checkPairs (fun l d : Y => K9 l d = ky l d)
        (fun _ _ => inferInstance) (by decide)) l))

end AlonJaegerTarsi.MarkedEleven
